        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"facets\": [],\n  \"sortAttribute\": \"\",\n  \"query\": \"cloud9\",\n  \"search_results_offset\": \"0\",\n  \"is_pre_search_tag\": false,\n  \"page_type\": \"INSTAMART_SEARCH_PAGE\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1152,
        128
      ],
      "id": "0bc83ccc-6aa1-43a8-bba8-e6a46fc75b48",
      "name": "Search Cloud9"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst extractedData = [];\n\nitems.forEach(item => {\n  const responseData = item.json.data || item.json;\n  const cards = responseData.cards || [];\n\n  cards.forEach(cardWrapper => {\n    const widget = cardWrapper.card?.card;\n    if (!widget) return;\n\n    const widgetType = widget['@type'];\n    let itemsList = [];\n\n    if (widgetType === 'type.googleapis.com/swiggy.gandalf.widgets.v2.GridWidget') {\n      itemsList = widget.gridElements?.infoWithStyle?.items || [];\n    } else if (widgetType === 'type.googleapis.com/swiggy.im.v1.OOSItemCollectionCard') {\n      itemsList = widget.items?.items || [];\n    }\n\n    itemsList.forEach(prodItem => {\n      const brandName = (prodItem.brand || \"\").toLowerCase();\n      const parentProductName = prodItem.displayName || \"\"; \n      \n      if (brandName.includes(\"cloud9\") || parentProductName.toLowerCase().includes(\"cloud 9\")) {\n        const variations = prodItem.variations || [];\n\n        variations.forEach(variant => {\n          extractedData.push({\n            pincode: $('Loop Over Items').first().json.pincode || \"N/A\",\n            parent_product_name: parentProductName,\n            variant_product_name: variant.displayName,\n            sku_id: variant.skuId,\n            size: variant.quantityDescription,\n            mrp: variant.price?.mrp?.units || \"N/A\",\n            offer_price: variant.price?.offerPrice?.units || \"N/A\",\n            in_stock: variant.inventory?.inStock ? \"Yes\" : \"Out of Stock\",\n            max_allowed_cart_qty: variant.cartAllowedQuantity?.allowedQuantity || 0\n          });\n        });\n      }\n    });\n  });\n});\n\n// Returns everything wrapped in ONE clean array item so it never triggers an invalid JSON error\nreturn [{ json: { cloud9_inventory: extractedData } }];"
      },
      "type": "n8n-nodes-base.code",
